generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  draft
  applied
  interviewing
  offer
  rejected
}

enum JobSource {
  linkedin
  indeed
  company_website
  referral
  other
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
  jobs     Jobs[]
}

model Jobs {
  id          Int       @id @default(autoincrement())
  userId      Int
  companyName String
  position    String
  jobUrl      String
  jobDescription String
  status      JobStatus @default(draft)
  source      JobSource
  priority    Boolean   @default(false)
  notes       String?
  appliedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id])
}
